<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:process id="azure-ocr-document-processing" name="Azure OCR Document Processing" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent" name="Start">
      <bpmn:outgoing>Flow_StartToCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ReadFileFromDisk" name="Read File from Disk" camunda:type="external" camunda:topic="read-file-from-disk">
      <bpmn:incoming>Flow_ReadFile</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadFileToPrepare</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PrepareFileData" name="Prepare File Data" camunda:type="external" camunda:topic="prepare-file-data">
      <bpmn:incoming>Flow_StartToPrepare</bpmn:incoming>
      <bpmn:incoming>Flow_ReadFileToPrepare</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitOCR</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SubmitToAzureOCR" name="Submit to Azure OCR" camunda:type="external" camunda:topic="submit-to-azure-ocr">
      <bpmn:incoming>Flow_SubmitOCR</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtractRequestId</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ExtractRequestId" name="Extract Request ID" camunda:type="external" camunda:topic="extract-request-id">
      <bpmn:incoming>Flow_ExtractRequestId</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckSubmission</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CheckSubmissionSuccess" name="Check Submission Success">
      <bpmn:incoming>Flow_CheckSubmission</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitBeforePoll</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnError</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="WaitBeforeFirstPoll" name="Wait Before First Poll">
      <bpmn:incoming>Flow_WaitBeforePoll</bpmn:incoming>
      <bpmn:outgoing>Flow_PollOCRResults</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="PollOCRResults" name="Poll OCR Results" camunda:type="external" camunda:topic="poll-ocr-results">
      <bpmn:incoming>Flow_PollOCRResults</bpmn:incoming>
      <bpmn:incoming>Flow_WaitBeforeRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckOCRStatus</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CheckOCRStatus" name="Check OCR Status">
      <bpmn:incoming>Flow_CheckOCRStatus</bpmn:incoming>
      <bpmn:outgoing>Flow_IncrementRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_ExtractResults</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IncrementRetryCount" name="Increment Retry Count" camunda:type="external" camunda:topic="increment-retry-count">
      <bpmn:incoming>Flow_IncrementRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckMaxRetries</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CheckMaxRetries" name="Check Max Retries">
      <bpmn:incoming>Flow_CheckMaxRetries</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitBeforeRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnTimeout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="WaitBeforeRetry" name="Wait Before Retry">
      <bpmn:incoming>Flow_WaitBeforeRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_PollOCRResults</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ExtractOCRResults" name="Extract OCR Results" camunda:type="external" camunda:topic="extract-ocr-results">
      <bpmn:incoming>Flow_ExtractResults</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckOCRSuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CheckOCRSuccess" name="Check OCR Success">
      <bpmn:incoming>Flow_CheckOCRSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewOCRResults</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReturnSuccess</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ReviewOCRResults" name="Review OCR Results" camunda:formKey="camunda-forms:deployment:forms/review-ocr-form.form">
      <bpmn:incoming>Flow_ReviewOCRResults</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterReview</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ReturnSuccessResponse" name="Return Success Response">
      <bpmn:incoming>Flow_ReturnSuccess</bpmn:incoming>
      <bpmn:incoming>Flow_AfterReview</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ReturnErrorResponse" name="Return Error Response">
      <bpmn:incoming>Flow_ReturnError</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ReturnTimeoutResponse" name="Return Timeout Response">
      <bpmn:incoming>Flow_ReturnTimeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="CheckFilePath" name="Check File Path">
      <bpmn:incoming>Flow_StartToCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadFile</bpmn:outgoing>
      <bpmn:outgoing>Flow_StartToPrepare</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_StartToCheck" sourceRef="StartEvent" targetRef="CheckFilePath" />
    <bpmn:sequenceFlow id="Flow_ReadFile" name="filePath exists" sourceRef="CheckFilePath" targetRef="ReadFileFromDisk">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${filePath != null && filePath != ''}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_StartToPrepare" name="no filePath" sourceRef="CheckFilePath" targetRef="PrepareFileData">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${filePath == null || filePath == ''}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReadFileToPrepare" sourceRef="ReadFileFromDisk" targetRef="PrepareFileData" />
    <bpmn:sequenceFlow id="Flow_SubmitOCR" sourceRef="PrepareFileData" targetRef="SubmitToAzureOCR" />
    <bpmn:sequenceFlow id="Flow_ExtractRequestId" sourceRef="SubmitToAzureOCR" targetRef="ExtractRequestId" />
    <bpmn:sequenceFlow id="Flow_CheckSubmission" sourceRef="ExtractRequestId" targetRef="CheckSubmissionSuccess" />
    <bpmn:sequenceFlow id="Flow_WaitBeforePoll" name="Status Code = 202" sourceRef="CheckSubmissionSuccess" targetRef="WaitBeforeFirstPoll">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${statusCode == 202}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnError" name="Status Code != 202" sourceRef="CheckSubmissionSuccess" targetRef="ReturnErrorResponse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${statusCode != 202}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PollOCRResults" sourceRef="WaitBeforeFirstPoll" targetRef="PollOCRResults" />
    <bpmn:sequenceFlow id="Flow_CheckOCRStatus" sourceRef="PollOCRResults" targetRef="CheckOCRStatus" />
    <bpmn:sequenceFlow id="Flow_IncrementRetry" name="Status = running" sourceRef="CheckOCRStatus" targetRef="IncrementRetryCount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${ocrStatus == 'running'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ExtractResults" name="Status != running" sourceRef="CheckOCRStatus" targetRef="ExtractOCRResults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${ocrStatus != 'running'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CheckMaxRetries" sourceRef="IncrementRetryCount" targetRef="CheckMaxRetries" />
    <bpmn:sequenceFlow id="Flow_WaitBeforeRetry" name="Retry Count &#60; 20" sourceRef="CheckMaxRetries" targetRef="WaitBeforeRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${retryCount < 20}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnTimeout" name="Retry Count &#62;= 20" sourceRef="CheckMaxRetries" targetRef="ReturnTimeoutResponse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${retryCount >= 20}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CheckOCRSuccess" sourceRef="ExtractOCRResults" targetRef="CheckOCRSuccess" />
    <bpmn:sequenceFlow id="Flow_ReviewOCRResults" name="OCR Succeeded" sourceRef="CheckOCRSuccess" targetRef="ReviewOCRResults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${ocrStatus == 'succeeded'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnSuccess" name="OCR Failed or No Results" sourceRef="CheckOCRSuccess" targetRef="ReturnSuccessResponse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${ocrStatus != 'succeeded'}]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AfterReview" sourceRef="ReviewOCRResults" targetRef="ReturnSuccessResponse" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="azure-ocr-document-processing">
      <bpmndi:BPMNShape id="_BPMNShape_ScriptTask_1" bpmnElement="PrepareFileData">
