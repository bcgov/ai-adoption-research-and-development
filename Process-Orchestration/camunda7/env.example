# Camunda 7 Docker Compose Environment Variables
# Copy this file to .env and adjust values as needed
# cp env.example .env

# Camunda 7 (Run) version
CAMUNDA_7_VERSION=7.21.0

# Camunda admin user for webapps/REST (basic auth)
CAMUNDA_ADMIN_USER=demo
CAMUNDA_ADMIN_PASSWORD=demo

# Camunda REST endpoint + worker auth
CAMUNDA_ENGINE_URL=http://localhost:8080/engine-rest
CAMUNDA_BASIC_AUTH_USER=demo
CAMUNDA_BASIC_AUTH_PASSWORD=demo
# Optional: set a fixed worker id for all external-task workers
CAMUNDA_WORKER_ID=ocr-workers

# Human-in-the-loop review base URL (used to build reviewUrl)
HITL_REVIEW_BASE_URL=https://example.com/review

# Webhook server
WEBHOOK_PORT=3000

# Azure Document Intelligence credentials
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# GitHub Agent credentials
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Get your GitHub token from: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=
# Optional: default repository for the agent
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

