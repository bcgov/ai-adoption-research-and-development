{
  "name": "camunda7-workflows",
  "version": "1.0.0",
  "description": "Camunda 7 BPMN workflows including Azure OCR document processing and GitHub AI Agent",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:workers": "node dist/workers/index.js",
    "start:webhook": "node dist/webhook/server.js",
    "deploy": "node dist/deploy.js",
    "dev": "ts-node-dev --respawn --transpile-only index.ts",
    "dev:workers": "ts-node-dev --respawn --transpile-only workers/index.ts",
    "dev:webhook": "ts-node-dev --respawn --transpile-only webhook/server.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "camunda7",
    "camunda",
    "external-task",
    "bpmn",
    "ocr",
    "azure",
    "document-intelligence",
    "github",
    "ai-agent",
    "gemini",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@octokit/rest": "^21.0.2",
    "axios": "^1.6.0",
    "camunda-external-task-client-js": "^3.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.1.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
