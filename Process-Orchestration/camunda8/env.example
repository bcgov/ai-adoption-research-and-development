# Camunda Docker Compose Environment Variables
# Copy this file to .env and adjust versions as needed
# cp env.example .env

# Camunda Platform version (consolidated Zeebe + Operate + Tasklist)
# See available versions: https://hub.docker.com/r/camunda/camunda/tags
CAMUNDA_VERSION=8.8.7

# Camunda Connectors Bundle version
# See available versions: https://hub.docker.com/r/camunda/connectors-bundle/tags
CAMUNDA_CONNECTORS_VERSION=8.8.4

# Elasticsearch version
# See available versions: https://www.docker.elastic.co/r/elasticsearch/elasticsearch
# Note: Camunda 8.8.7 requires Elasticsearch 8.16+ for compatibility
ELASTIC_VERSION=8.16.0

