{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["invoiceNumber", "date", "amount", "taxId", "vendorName", "lineItems"],
  "properties": {
    "invoiceNumber": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "description": "Unique invoice identifier"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Invoice date in ISO 8601 format"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 999999.99,
      "multipleOf": 0.01,
      "description": "Total invoice amount"
    },
    "taxId": {
      "type": "string",
      "pattern": "^[A-Z0-9]{9,15}$",
      "description": "Vendor tax identification number"
    },
    "vendorName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Name of the vendor"
    },
    "lineItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unitPrice"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 10000
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999.99,
            "multipleOf": 0.01
          }
        }
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "default": "USD",
      "description": "Currency code (ISO 4217)"
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional notes or comments"
    }
  }
}

